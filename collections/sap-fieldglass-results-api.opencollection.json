{
  "opencollection": "1.0.0",
  "info": {
    "name": "Approval Results API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": " ",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Results",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Provides results for the work order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/result",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "Content-Type",
                "value": ""
              },
              {
                "name": "X-ApplicationKey",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "clientReferenceId",
                "value": "",
                "type": "query",
                "description": "Globally-unique SAP Fieldglass identifier of the object. This is the Work Order ID used for the drill-down call in SAP Fieldglass. It is not visible to end users."
              }
            ]
          },
          "docs": "Posts results for a specific background check request."
        }
      ]
    }
  ],
  "bundled": true
}